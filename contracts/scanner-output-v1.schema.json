{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cekvaluasi.com/contracts/scanner-output-v1.schema.json",
  "title": "CekValuasi Scanner Public Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "universe",
    "watchlist",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "scanner-summary-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "eligible",
        "evaluated"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "watchlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "states"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "WATCHLIST",
            "RESEARCH_CONFIRMED",
            "WAITING_CONFIRMATION",
            "EXTENDED",
            "LIMITED_EVIDENCE"
          ],
          "properties": {
            "WATCHLIST": {
              "type": "integer",
              "minimum": 0
            },
            "RESEARCH_CONFIRMED": {
              "type": "integer",
              "minimum": 0
            },
            "WAITING_CONFIRMATION": {
              "type": "integer",
              "minimum": 0
            },
            "EXTENDED": {
              "type": "integer",
              "minimum": 0
            },
            "LIMITED_EVIDENCE": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "state": {
      "enum": [
        "WATCHLIST",
        "RESEARCH_CONFIRMED",
        "WAITING_CONFIRMATION",
        "EXTENDED",
        "LIMITED_EVIDENCE"
      ]
    },
    "lens": {
      "enum": [
        "UNDERVALUED",
        "QUALITY_VALUE",
        "DIVIDEND_QUALITY",
        "QUALITY_GROWTH",
        "VALUE_MOMENTUM",
        "HIDDEN_OPPORTUNITY"
      ]
    },
    "overallEvidence": {
      "enum": [
        "STRONG",
        "ADEQUATE",
        "LIMITED"
      ]
    },
    "freshness": {
      "enum": [
        "CURRENT",
        "AGING",
        "STALE",
        "UNAVAILABLE"
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "name",
        "sector",
        "state",
        "stateLabel",
        "researchLens",
        "evidenceStrength",
        "primaryReason",
        "freshness",
        "detail",
        "fairValue"
      ],
      "properties": {
        "ticker": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4,6}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sector": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "stateLabel": {
          "type": "string",
          "minLength": 1
        },
        "researchLens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lens"
          }
        },
        "evidenceStrength": {
          "$ref": "#/$defs/overallEvidence"
        },
        "primaryReason": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "detail": {
          "type": "string",
          "pattern": "^/scanner/"
        },
        "fairValue": {
          "type": "string",
          "pattern": "^/fair-value/"
        }
      }
    }
  }
}
